{
  "name": "@local/session-concurrency",
  "version": "0.2.1",
  "description": "DSH 会话级 Agent 推理并发按钮；额度 1 时主会话等待子任务完成。",
  "type": "module",
  "license": "MIT",
  "author": "MingoYung",
  "repository": { "type": "git", "url": "git+https://github.com/MingoYung/dsh-session-concurrency.git" },
  "homepage": "https://github.com/MingoYung/dsh-session-concurrency#readme",
  "bugs": { "url": "https://github.com/MingoYung/dsh-session-concurrency/issues" },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "scheduler.js", "runtime.js", "remote.js", "lib", "cordis.patch.yml", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md", "docs/preview.png"],
  "engines": { "node": ">=24.9.0", "dsh": "0.2.1-rc.4 || 0.2.2-rc.1" },
  "dependencies": { "zod": "4.4.3" },
